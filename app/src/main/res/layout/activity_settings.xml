<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        app:layout_boxedEdges="left|right">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/round_scroll_pad"
            android:paddingBottom="@dimen/round_scroll_pad">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_server" />

            <EditText
                android:id="@+id/etHost"
                style="@style/PadBridge.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_host"
                android:inputType="textUri" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_port" />

            <EditText
                android:id="@+id/etPort"
                style="@style/PadBridge.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5" />

            <Button
                android:id="@+id/btnFind"
                style="@style/PadBridge.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_find_server" />

            <TextView
                android:id="@+id/tvFind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_transport" />

            <Button
                android:id="@+id/btnTransport"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_keepalive" />

            <Button
                android:id="@+id/btnKeepalive"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_link" />

            <Button
                android:id="@+id/btnLink"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_right_stick" />

            <Button
                android:id="@+id/btnRightStick"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_dead_zone" />

            <Button
                android:id="@+id/btnDeadZone"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSwap"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView style="@style/PadBridge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_screen" />

            <Button
                android:id="@+id/btnKeepOn"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnDim"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnRumble"
                style="@style/PadBridge.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_mono" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
